# Copy to common.env and edit. NEVER reuse another cluster's IPs/NICs/NCCL values blindly.
IMAGE=dynamo-vllm-runtime:1.5.1-vllm028-pcie-dual   # from scripts/find_latest_image.py (RECOMMENDED_IMAGE)
MODEL_DIR=/models                                   # host dir containing nvidia/GLM-5.2-NVFP4
MODEL_PATH=/models/nvidia/GLM-5.2-NVFP4
RESULTS_DIR=/path/to/results                        # logs land in $RESULTS_DIR/<role>/<role>.log
ETCD_ENDPOINTS=http://<CONTROL_HOST>:2379
NATS_SERVER=nats://<CONTROL_HOST>:4222
UCX_NET_DEVICES=mlx5_0:1                            # verify with ucx_info -d / ibdev2netdev / ibstat
PREFILL_KV_IP=<PREFILL_BUSINESS_IP>                 # NIXL side-channel host of the Prefill node
DECODE_KV_IP=<DECODE_BUSINESS_IP>
PREFILL_NIXL_PORT=20097
DECODE_NIXL_PORT=20098
PREFILL_SYSTEM_PORT=8082
DECODE_SYSTEM_PORT=8083
FRONTEND_PORT=8000
PREFIX_CACHE=on                                     # on | off  (off => --no-enable-prefix-caching)
# NCCL values below were validated on ONE topology (Handbook s4.4); re-run nccl-tests A/B on yours.
PREFILL_NCCL_P2P_LEVEL=PHB
DECODE_NCCL_P2P_LEVEL=SYS
